// ---------------------------------------------------------------------------
// Workflow builder (grafo editável)
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  RASCUNHO
  PUBLICADO
  PAUSADO

  @@map("workflow_status")
}

/// Canal de mensageria ao qual uma automação (ou um gatilho) pertence.
/// Apenas WHATSAPP está disponível para conexão real no MVP — INSTAGRAM e
/// FACEBOOK já existem no domínio para que o gatilho correto apareça assim
/// que esses canais forem habilitados.
enum Canal {
  WHATSAPP
  INSTAGRAM
  FACEBOOK

  @@map("canal")
}

model Workflow {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  nome      String
  descricao String?
  status    WorkflowStatus @default(RASCUNHO)
  canal     Canal          @default(WHATSAPP)
  version   Int            @default(1)

  /// Snapshot imutável do grafo publicado (nodes + edges + configs).
  /// O worker sempre executa este snapshot, nunca o grafo em edição.
  publishedJson Json?
  publishedAt   DateTime? @db.Timestamptz()

  /// Conexão ESPECÍFICA que dispara esta automação — qual número de WhatsApp,
  /// qual conta de Instagram, qual Página de Facebook. Cada canal tem a SUA
  /// tabela de conexões, e no máximo uma destas colunas é preenchida: a do
  /// `canal` do workflow.
  ///
  /// Antes este vínculo só existia dentro do `configJson` do nó de gatilho, o
  /// que obrigava o roteamento a varrer em memória o `publishedJson` de TODOS
  /// os workflows publicados a cada mensagem recebida, e impedia qualquer
  /// garantia de "uma automação ativa por conexão". O `configJson` do gatilho
  /// continua espelhando o valor, porque é o contrato do snapshot lido pelo
  /// motor — mas a coluna é a verdade.
  ///
  /// `SetNull` ao remover a conexão: o serviço de desconexão pausa antes as
  /// automações ativas vinculadas, para que nenhuma fique "ativa" presa a nada.
  whatsappConnectionId  String? @db.Uuid
  instagramConnectionId String? @db.Uuid
  facebookConnectionId  String? @db.Uuid

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappConnection  WhatsAppConnection?  @relation(fields: [whatsappConnectionId], references: [id], onDelete: SetNull)
  instagramConnection InstagramConnection? @relation(fields: [instagramConnectionId], references: [id], onDelete: SetNull)
  facebookConnection  FacebookConnection?  @relation(fields: [facebookConnectionId], references: [id], onDelete: SetNull)
  nodes               WorkflowNode[]
  edges               WorkflowEdge[]
  executions          WorkflowExecution[]

  @@index([tenantId])
  /// Chave do roteamento: "qual automação ATIVA responde por esta conexão".
  /// Contagem de automações por situação no painel de Analytics.
  @@index([tenantId, status])
  @@index([whatsappConnectionId, status])
  @@index([instagramConnectionId, status])
  @@index([facebookConnectionId, status])
  @@map("workflows")
}

model WorkflowNode {
  id         String @id @default(uuid()) @db.Uuid
  /// Id gerado no client (Flutter) para correlacionar upsert sem round-trip.
  clientId   String
  workflowId String @db.Uuid
  /// Denormalizado de Workflow.tenantId para permitir que o repository
  /// escopeie escritas por tenant sem depender só da camada de service.
  tenantId   String @db.Uuid
  nodeTypeId String @db.Uuid
  posX       Float
  posY       Float
  configJson Json

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeType NodeType @relation(fields: [nodeTypeId], references: [id])

  edgesSaida   WorkflowEdge[]          @relation("EdgeOrigem")
  edgesEntrada WorkflowEdge[]          @relation("EdgeDestino")
  execucoes    WorkflowExecutionNode[]

  @@unique([workflowId, clientId])
  @@index([workflowId])
  @@index([tenantId])
  @@index([nodeTypeId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id            String  @id @default(uuid()) @db.Uuid
  workflowId    String  @db.Uuid
  /// Denormalizado de Workflow.tenantId — mesmo motivo do WorkflowNode.
  tenantId      String  @db.Uuid
  origemNodeId  String  @db.Uuid
  destinoNodeId String  @db.Uuid
  /// Quando a origem é um nó condicional (ex.: botões), identifica qual
  /// saída/handle desta origem dispara esta edge.
  handleOrigem  String?

  workflow    Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  origemNode  WorkflowNode @relation("EdgeOrigem", fields: [origemNodeId], references: [id], onDelete: Cascade)
  destinoNode WorkflowNode @relation("EdgeDestino", fields: [destinoNodeId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([tenantId])
  @@index([origemNodeId])
  @@index([destinoNodeId])
  @@map("workflow_edges")
}

model NodeType {
  id               String  @id @default(uuid()) @db.Uuid
  /// Ex.: "MENSAGEM_SIMPLES" | "MENSAGEM_BOTOES" | "AGUARDAR_RESPOSTA" | "MIDIA"
  chave            String  @unique
  label            String
  descricao        String?
  icone            String?
  /// JSON Schema descrevendo os campos configuráveis — usado para gerar o
  /// formulário no inspector do Flutter dinamicamente.
  schemaJson       Json
  /// Chave que o worker usa para despachar a execução deste tipo de nó.
  executor         String
  supportsBranches Boolean @default(false)
  maxOutputs       Int     @default(1)
  isEnabled        Boolean @default(true)
  /// Trigger nodes start a workflow (e.g. "on WhatsApp message received")
  /// and have no input handle — nothing can connect into them.
  isTrigger        Boolean @default(false)
  /// Only set for trigger node types — scopes which channel's workflows may
  /// use this trigger (e.g. the WhatsApp trigger only appears in WhatsApp
  /// automations). Null for channel-agnostic action node types.
  canal            Canal?
  ordem            Int     @default(0)

  nodes WorkflowNode[]

  @@map("node_types")
}

// ---------------------------------------------------------------------------
// Execução do workflow (worker)
// ---------------------------------------------------------------------------

enum WorkflowExecutionStatus {
  RUNNING
  WAITING
  FINISHED
  FAILED
  CANCELLED

  @@map("workflow_execution_status")
}

enum WorkflowExecutionNodeStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED

  @@map("workflow_execution_node_status")
}

model WorkflowExecution {
  id         String @id @default(uuid()) @db.Uuid
  workflowId String @db.Uuid
  contatoId  String @db.Uuid

  /// Versão do workflow que originou esta execução — junto com o índice único
  /// abaixo, um contato só entra uma vez por versão publicada.
  workflowVersion Int                     @default(1)
  currentNodeId   String?                 @db.Uuid
  status          WorkflowExecutionStatus @default(RUNNING)

  iniciadoEm   DateTime  @default(now()) @db.Timestamptz()
  finalizadoEm DateTime? @db.Timestamptz()

  workflow Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contato  Contato                 @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  nodes    WorkflowExecutionNode[]
  wait     WorkflowExecutionWait?

  @@unique([workflowId, contatoId, workflowVersion])
  @@index([workflowId])
  /// O painel de Analytics sempre lê por workflow E por janela de tempo (a
  /// tabela não tem `tenantId`, então o escopo vem do JOIN com `workflows`).
  /// Sem este índice, todo gráfico de período faz varredura completa.
  @@index([workflowId, iniciadoEm])
  @@index([contatoId])
  @@index([status])
  @@map("workflow_executions")
}

model WorkflowExecutionNode {
  id           String                      @id @default(uuid()) @db.Uuid
  executionId  String                      @db.Uuid
  nodeId       String                      @db.Uuid
  status       WorkflowExecutionNodeStatus @default(PENDING)
  /// Qual passagem do fluxo por este nó — 0 é a primeira, e cada nó
  /// "Reiniciar automação" executado abre a volta seguinte. Guardar a volta é o
  /// que permite ao fluxo voltar atrás E manter o histórico de cada passagem.
  volta        Int                         @default(0)
  input        Json?
  output       Json?
  erro         String?
  iniciadoEm   DateTime?                   @db.Timestamptz()
  finalizadoEm DateTime?                   @db.Timestamptz()
  criadoEm     DateTime                    @default(now()) @db.Timestamptz()

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// Trava de idempotência do motor: o INSERT desta linha É o "reivindicar
  /// este nó" (mesmo padrão de `WorkflowExecution`). Se o motor cair e
  /// reprocessar a mesma execução do zero, o segundo INSERT colide (P2002) e
  /// o motor sabe que já cuidou deste nó, sem reenviar mensagem duplicada.
  ///
  /// A `volta` entra na chave porque voltar atrás DEVE reexecutar: sem ela, o
  /// "Reiniciar automação" colidiria com a passagem anterior e o trecho
  /// repetido seria pulado em silêncio.
  @@unique([executionId, nodeId, volta])
  @@index([executionId])
  @@index([nodeId])
  @@map("workflow_execution_nodes")
}

model WorkflowExecutionWait {
  id              String    @id @default(uuid()) @db.Uuid
  executionId     String    @unique @db.Uuid
  executionNodeId String    @db.Uuid
  resumeAt        DateTime  @db.Timestamptz()
  /// Ids dos nós restantes a processar quando a espera resolver.
  pendingQueue    Json
  /// Guarda contra reprocessamento em caso de loop.
  visitedNodeIds  Json
  resolvedAt      DateTime? @db.Timestamptz()
  /// "TIMEOUT" | "REPLY"
  resolvedReason  String?
  /// `false` no "Atraso inteligente": a espera é só de TEMPO, e uma mensagem
  /// do contato no meio dela não pode adiantar o fluxo.
  aceitaResposta  Boolean   @default(true)
  criadoEm        DateTime  @default(now()) @db.Timestamptz()

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([resumeAt])
  @@map("workflow_execution_waits")
}

// ---------------------------------------------------------------------------
// Agentes IA
// ---------------------------------------------------------------------------

enum AgenteTom {
  PROFISSIONAL
  CONSULTIVO
  AMIGAVEL
  PERSUASIVO

  @@map("agente_tom")
}

enum AgenteStatus {
  RASCUNHO
  ATIVO
  INATIVO

  @@map("agente_status")
}

model Agente {
  id       String  @id @default(uuid()) @db.Uuid
  /// Null apenas para os templates globais da Biblioteca — visíveis a todos
  /// os tenants, nunca editáveis diretamente (o usuário clona via "Usar
  /// agente", que cria uma cópia própria com tenantId preenchido).
  tenantId String? @db.Uuid

  nome     String
  funcao   String
  tom      AgenteTom @default(PROFISSIONAL)
  objetivo String?

  /// Prompt de sistema enviado à OpenAI — descreve como o agente deve agir.
  instrucoes String

  /// Lista de chaves de ferramentas habilitadas, ex.: ["whatsapp","instagram","facebook","email","webhook","agenda"].
  /// A UI só permite habilitar canais que o tenant realmente tem conectados.
  ferramentas Json @default("[]")

  memoriaContextual    Boolean @default(true)
  horarioInicio        String?
  horarioFim           String?
  transferirParaHumano Boolean @default(true)

  /// Envelope AES-256-GCM (mesmo formato do WhatsAppConnection.accessTokenEncrypted).
  ///
  /// NÃO é mais o caminho normal: a IA passou a ser paga em créditos, com a
  /// chave da PLATAFORMA (`OPENAI_API_KEY`, só no backend). Esta coluna é a
  /// costura do BYOK — "traga sua própria chave" — que um plano poderá
  /// liberar no futuro (ver `PlanDefinition.aiByokPermitido`). Continua aqui,
  /// e não foi derrubada, porque apagar a coluna destruiria as chaves que os
  /// clientes já cadastraram, e o BYOK está previsto, não descartado.
  /// Nunca retornada em texto puro.
  openAiApiKeyEncrypted String?
  /// Modelo usado nas chamadas deste agente. O padrão vem de
  /// `AI_DEFAULT_MODEL`; o valor guardado aqui vence, para que um agente
  /// afinado num modelo específico não mude de comportamento num deploy.
  openAiModel           String  @default("gpt-4o-mini")

  status AgenteStatus @default(RASCUNHO)

  /// True somente para os 3 templates pré-configurados da Biblioteca.
  isTemplate             Boolean @default(false)
  templateChave          String? @unique
  /// Preenchido quando este agente foi criado via "Usar agente" a partir de
  /// um template — permite contar quantas vezes cada template da Biblioteca
  /// foi adotado (métrica real, ao contrário de um contador inventado).
  clonadoDeTemplateChave String?

  /// Incrementado a cada uso do botão "Testar agente" — única métrica de uso
  /// real disponível hoje (não há motor de execução de workflow ainda).
  execucoesTeste Int @default(0)

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contatosAtivos Contato[]

  @@index([tenantId])
  @@map("agentes")
}

// ---------------------------------------------------------------------------
// Conexões do Instagram (Direct)
// ---------------------------------------------------------------------------

enum InstagramConnectionStatus {
  PENDENTE
  CONECTADO
  EXPIRADO
  ERRO

  @@map("instagram_connection_status")
}

/// Conta profissional do Instagram conectada pela "Instagram API with
/// Instagram Login" — a pessoa entra com a própria conta, sem Página do
/// Facebook. Contraparte da `WhatsAppConnection`, com tabela própria.
model InstagramConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Id da conta profissional (`user_id` do /me) — é o `recipient.id` dos
  /// webhooks, e por isso a chave do roteamento de mensagens recebidas.
  instagramUserId String
  username        String?

  /// Mesmo envelope AES-256-GCM do WhatsAppConnection. Token de usuário do
  /// Instagram (graph.instagram.com).
  accessTokenEncrypted String
  /// O token longo vale 60 dias e precisa ser renovado antes disso.
  tokenExpiresAt       DateTime? @db.Timestamptz()

  status       InstagramConnectionStatus @default(PENDENTE)
  conectadoEm  DateTime?                 @db.Timestamptz()
  criadoEm     DateTime                  @default(now()) @db.Timestamptz()
  atualizadoEm DateTime                  @updatedAt @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  /// Uma conta do Instagram pertence a um único tenant — impede roteamento
  /// cruzado de webhooks.
  @@unique([instagramUserId])
  @@index([tenantId])
  @@map("instagram_connections")
}

// ---------------------------------------------------------------------------
// Conexões do Facebook Messenger
// ---------------------------------------------------------------------------

enum FacebookConnectionStatus {
  PENDENTE
  CONECTADO
  EXPIRADO
  ERRO

  @@map("facebook_connection_status")
}

/// Página do Facebook conectada para o Messenger. A tabela já existe para o
/// vínculo com automações e os limites do plano; o fluxo de conexão e o
/// webhook do Messenger ainda serão integrados.
model FacebookConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Id da Página — o `recipient.id` dos webhooks do Messenger.
  pageId   String
  pageName String?

  /// Mesmo envelope AES-256-GCM do WhatsAppConnection. Token de Página
  /// (graph.facebook.com).
  accessTokenEncrypted String

  status       FacebookConnectionStatus @default(PENDENTE)
  conectadoEm  DateTime?                @db.Timestamptz()
  criadoEm     DateTime                 @default(now()) @db.Timestamptz()
  atualizadoEm DateTime                 @updatedAt @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  @@unique([pageId])
  @@index([tenantId])
  @@map("facebook_connections")
}

// ---------------------------------------------------------------------------
// Webhooks personalizados
// ---------------------------------------------------------------------------

model CustomWebhook {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  nomeEvento String
  descricao  String?

  /// Segmento público da URL (`/custom-webhooks/receive/:tokenPublico`) —
  /// não é secreto por si só, apenas identifica qual webhook recebeu a
  /// chamada; a autenticação real é o header `X-Webhook-Secret`.
  tokenPublico String @unique @default(uuid())
  /// Hash SHA-256 do secret mostrado ao usuário uma única vez na criação.
  secretHash   String

  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now()) @db.Timestamptz()
  ultimoRecebidoEm DateTime? @db.Timestamptz()

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries CustomWebhookDelivery[]

  @@index([tenantId])
  @@map("custom_webhooks")
}

model CustomWebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @db.Uuid
  payload    Json
  recebidoEm DateTime @default(now()) @db.Timestamptz()

  webhook CustomWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("custom_webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Cobrança — Mercado Pago
// ---------------------------------------------------------------------------

/// Situação de acesso do tenant à plataforma.
///
/// Quem decide se a API responde NÃO é este campo, e sim
/// `Assinatura.acessoExpiraEm`: um registro pode estar marcado como ATIVA e já
/// ter vencido entre um ciclo do poller e o próximo. O status existe para ser
/// exibido e consultado; a data é a verdade.
enum AssinaturaStatus {
  /// Nunca houve pagamento aprovado — é assim que todo tenant nasce.
  PENDENTE
  ATIVA
  /// Teve acesso, mas os 30 dias do último pagamento acabaram.
  VENCIDA
  /// Assinatura recorrente cancelada/pausada na Mercado Pago, ou pagamento
  /// estornado. O acesso já pago não é retirado (ver `acessoExpiraEm`) — o que
  /// deixa de acontecer é a renovação.
  CANCELADA

  @@map("assinatura_status")
}

/// Como este tenant paga.
enum AssinaturaOrigem {
  /// Assinatura por cartão na Mercado Pago (preapproval): a própria MP cobra
  /// de novo a cada ciclo e dispara um webhook a cada cobrança.
  ASSINATURA_RECORRENTE
  /// Link de pagamento avulso: cada pagamento libera 30 dias e nada renova
  /// sozinho — passados os 30 dias sem novo pagamento, a plataforma bloqueia.
  LINK_PAGAMENTO
  /// Liberado manualmente (conta interna, revisão da Meta, cortesia comercial).
  CORTESIA

  @@map("assinatura_origem")
}

/// Estado de cobrança de um tenant — exatamente um registro por tenant.
model Assinatura {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid

  /// Plano PAGO. `Tenant.plano` é espelho deste valor (é ele que os limites
  /// leem); aqui fica o registro de o que de fato foi cobrado.
  plano  PlanoTipo         @default(STARTER)
  status AssinaturaStatus  @default(PENDENTE)
  origem AssinaturaOrigem?

  /// Até quando a plataforma responde para este tenant. `null` = nunca pagou.
  /// Cada pagamento aprovado empurra esta data 30 dias para frente, a partir
  /// do maior valor entre "agora" e a data que já estava aqui — pagar antes do
  /// fim do ciclo soma, não desperdiça.
  acessoExpiraEm DateTime? @db.Timestamptz()

  /// E-mail usado no checkout da Mercado Pago. É por ele que um pagamento
  /// feito num link avulso (que não carrega o id do tenant) encontra a conta.
  payerEmail String?

  /// `preapproval` da Mercado Pago, quando o plano é por assinatura recorrente.
  mercadoPagoPreapprovalId String? @unique

  ultimoPagamentoId String?
  ultimoPagamentoEm DateTime? @db.Timestamptz()
  canceladoEm       DateTime? @db.Timestamptz()

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// O poller de vencimento varre por data; sem índice ele faria varredura
  /// completa a cada ciclo.
  @@index([status, acessoExpiraEm])
  @@map("assinaturas")
}

/// Todo pagamento que a Mercado Pago nos contou — inclusive os que não
/// achamos dono. Guardar o não reconciliado é o que permite ligar depois, à
/// mão, um pagamento feito com e-mail diferente do da conta.
model PagamentoMercadoPago {
  id String @id @default(uuid()) @db.Uuid

  /// `null` enquanto não se sabe de quem é o pagamento.
  tenantId String? @db.Uuid

  /// Id do pagamento na Mercado Pago — chave natural, e a trava que impede
  /// que uma reentrega do webhook conceda 30 dias duas vezes.
  mercadoPagoPaymentId String @unique

  /// `approved` | `pending` | `rejected` | `refunded` | `charged_back` …
  /// Texto puro de propósito: é vocabulário da Mercado Pago, não nosso, e
  /// virar enum aqui só criaria migração a cada status novo que eles criem.
  status String

  origem        AssinaturaOrigem
  valorCentavos Int
  /// Plano identificado pelo valor cobrado. `null` quando o valor não bate com
  /// nenhum plano do catálogo — o pagamento fica registrado, mas NÃO libera
  /// acesso, e o log aponta a divergência.
  plano         PlanoTipo?

  payerEmail        String?
  externalReference String?
  preapprovalId     String?

  aprovadoEm DateTime? @db.Timestamptz()
  /// Resposta crua da API da Mercado Pago, para auditoria e para reprocessar
  /// um pagamento sem precisar consultá-los de novo.
  payload    Json
  criadoEm   DateTime  @default(now()) @db.Timestamptz()

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([payerEmail])
  /// A tela de reconciliação lista justamente os órfãos, mais novos primeiro.
  @@index([tenantId, criadoEm])
  @@map("pagamentos_mercado_pago")
}

/// Toda notificação recebida da Mercado Pago, válida ou não — mesma função do
/// `ChannelWebhookEvent` para os canais: deduplicar reentregas e deixar
/// trilha de quem bateu aqui.
model MercadoPagoWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  /// `payment` | `subscription_preapproval` | `subscription_authorized_payment` …
  tipo            String
  /// Identidade da NOTIFICAÇÃO (o campo `id` do corpo), não do recurso: a
  /// Mercado Pago avisa sobre o mesmo pagamento várias vezes — uma quando ele
  /// nasce pendente, outra quando é aprovado — e cada aviso tem id próprio.
  /// Deduplicar pelo id do pagamento faria a aprovação ser descartada como
  /// "repetida". Sem `id` no corpo (formato IPN antigo), cai no SHA-256 do
  /// corpo bruto.
  externalEventId String @unique

  signatureValid Boolean
  payload        Json
  status         WebhookEventStatus @default(RECEIVED)
  erro           String?

  criadoEm     DateTime  @default(now()) @db.Timestamptz()
  processadoEm DateTime? @db.Timestamptz()

  @@index([status])
  @@index([criadoEm])
  @@map("mercado_pago_webhook_events")
}

// ---------------------------------------------------------------------------
// Créditos de IA
//
// O cliente não traz mais chave da OpenAI: ele compra CAPACIDADE de IA da
// plataforma, medida em créditos. A chave (e o custo real do provedor) são da
// plataforma e nunca saem do backend.
//
// O crédito é uma unidade INTERNA. A relação entre tokens do provedor e
// créditos é configuração (`AI_CREDIT_TOKEN_RATIO`), não schema — mudar a
// conversão não pode exigir migração nem reescrever histórico.
// ---------------------------------------------------------------------------

/// De onde veio um crédito. Existe separado do saldo total porque as duas
/// origens têm regras de vida diferentes: o crédito do plano é renovado (e
/// zerado) a cada ciclo pago; o comprado foi pago à parte e sobrevive ao ciclo.
enum AiCreditOrigem {
  /// Concedido pela assinatura — expira quando o ciclo seguinte concede de novo.
  PLANO
  /// Pacote avulso comprado pelo cliente — não expira na virada do ciclo.
  COMPRADO

  @@map("ai_credit_origem")
}

/// Toda alteração de saldo tem um destes. O saldo NUNCA muda sem uma linha em
/// `ai_credit_transactions` — é essa regra que torna a carteira auditável.
enum AiCreditTransactionType {
  /// Créditos incluídos no plano, concedidos na ativação/renovação.
  CONCESSAO_PLANO
  /// Pacote adicional, creditado só após pagamento confirmado pelo webhook.
  COMPRA
  /// Reserva feita antes de chamar o provedor de IA (débito).
  CONSUMO
  /// Devolução do que foi reservado e não consumido, ou da chamada que falhou.
  ESTORNO
  /// Créditos do plano zerados na virada do ciclo.
  EXPIRACAO
  /// Acerto manual da operação, ou o excedente quando o consumo real passou da
  /// reserva.
  AJUSTE

  @@map("ai_credit_transaction_type")
}

/// Ciclo de vida de uma chamada de IA. RESERVADO é estado transitório: toda
/// chamada termina CONSUMIDO (deu certo) ou ESTORNADO (falhou).
enum AiUsageStatus {
  RESERVADO
  CONSUMIDO
  ESTORNADO

  @@map("ai_usage_status")
}

enum AiCreditPurchaseStatus {
  /// Checkout criado, dinheiro não confirmado. NÃO credita nada.
  PENDENTE
  /// Webhook confirmou o pagamento e os créditos entraram na carteira.
  PAGA
  /// Recusada, expirada ou estornada.
  CANCELADA

  @@map("ai_credit_purchase_status")
}

/// Carteira de créditos de IA — exatamente uma por tenant.
///
/// O saldo é guardado em DOIS potes em vez de um número só. Sem a separação
/// não há como zerar o crédito do plano na virada do ciclo sem levar junto o
/// pacote que o cliente pagou à parte.
///
/// `reservado` é o que está em voo: créditos já debitados dos potes para uma
/// chamada que ainda não voltou. Ele existe para que o saldo exibido nunca
/// prometa capacidade que outra requisição já tomou.
model AiCreditWallet {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid

  /// Concedido pela assinatura. Zerado e reconcedido a cada ciclo pago.
  saldoPlano    Int @default(0)
  /// Comprado em pacote avulso. Atravessa a virada do ciclo.
  saldoComprado Int @default(0)
  /// Debitado dos potes acima e ainda não liquidado (chamadas em voo).
  reservado     Int @default(0)

  /// Acumuladores de vida inteira, para o painel e para relatório financeiro.
  /// São somas do histórico, nunca a fonte do saldo.
  totalConcedido Int @default(0)
  totalComprado  Int @default(0)
  totalConsumido Int @default(0)

  /// Qual concessão de plano já foi aplicada. É a trava de idempotência: a
  /// reentrega de um webhook de pagamento não pode conceder o pacote mensal
  /// duas vezes.
  ultimaConcessaoRef String?
  ultimaConcessaoEm  DateTime? @db.Timestamptz()

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_credit_wallets")
}

/// Livro-razão da carteira. Imutável por natureza: nada aqui é atualizado ou
/// apagado — um erro se corrige com uma transação de AJUSTE, nunca reescrevendo
/// a linha errada.
model AiCreditTransaction {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  /// Quem disparou. `null` no que é da máquina: concessão de plano, expiração
  /// de ciclo, crédito vindo de webhook.
  usuarioId String? @db.Uuid

  tipo   AiCreditTransactionType
  /// De qual pote saiu/entrou. `null` quando a movimentação tocou os dois.
  origem AiCreditOrigem?

  /// Positivo credita, negativo debita. Nunca zero.
  quantidade  Int
  /// Saldo total (plano + comprado) imediatamente antes e depois. Guardado, e
  /// não recalculado: é o que permite auditar a carteira sem depender de
  /// reprocessar o histórico inteiro na ordem certa.
  saldoAntes  Int
  saldoDepois Int

  descricao    String
  /// O que originou a movimentação, conforme o tipo: id do `AiUsage`, do
  /// `AiCreditPurchase`, do pagamento na Mercado Pago, ou da concessão.
  referenciaId String?
  metadata     Json?

  criadoEm DateTime @default(now()) @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// O extrato é sempre "deste tenant, do mais novo para o mais velho".
  @@index([tenantId, criadoEm])
  @@index([referenciaId])
  @@map("ai_credit_transactions")
}

/// Uma chamada ao provedor de IA: o que foi pedido, quantos tokens custou e
/// quantos créditos isso virou.
///
/// Esta tabela é a resposta para "quem consumiu, em quê, com qual modelo" — e
/// a única fonte do relatório de margem, já que guarda os tokens REAIS ao lado
/// dos créditos cobrados.
model AiUsage {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  /// `null` quando quem consumiu foi o motor (workflow/agente respondendo um
  /// contato), não uma pessoa numa tela.
  usuarioId String? @db.Uuid

  /// `openai` | `anthropic` | `gemini` … — texto puro porque é vocabulário de
  /// terceiros e virar enum obrigaria a migrar a cada provedor novo.
  provider String
  model    String
  /// Que parte do produto gastou: `agente_teste`, `agente_conversa`, …
  feature  String

  status AiUsageStatus @default(RESERVADO)

  /// Uso REAL informado pelo provedor. Fica zerado enquanto a chamada não volta.
  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  /// Debitado ANTES da chamada, pela estimativa.
  creditosReservados Int
  /// Debitado de fato depois da liquidação. `0` em chamada estornada.
  creditosConsumidos Int @default(0)

  /// Idempotência da liquidação: uma mesma chamada não pode ser cobrada duas
  /// vezes, mesmo se o handler for reexecutado.
  requestId String @unique

  agenteId            String? @db.Uuid
  contatoId           String? @db.Uuid
  workflowExecutionId String? @db.Uuid
  /// Motivo do estorno, quando houve.
  erro                String?
  metadata            Json?

  criadoEm     DateTime  @default(now()) @db.Timestamptz()
  finalizadoEm DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
  @@index([tenantId, status])
  @@index([agenteId])
  @@map("ai_usages")
}

/// Pacote de créditos à venda. Editável pela operação sem deploy — ao
/// contrário do catálogo de planos, que é código porque governa LIMITES, aqui
/// só há preço e quantidade.
model AiCreditPackage {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String
  creditos      Int
  /// Em centavos, para não carregar ponto flutuante em dinheiro.
  precoCentavos Int
  ativo         Boolean @default(true)
  /// Ordem de exibição na vitrine.
  ordem         Int     @default(0)

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  compras AiCreditPurchase[]

  @@index([ativo, ordem])
  @@map("ai_credit_packages")
}

/// Uma intenção de compra de pacote.
///
/// Nasce PENDENTE junto com o checkout e só vira PAGA pelo webhook do gateway.
/// Existir antes do pagamento é o que permite reconhecer, na volta, QUAL
/// pacote foi comprado e por qual tenant — sem depender do valor pago nem da
/// palavra do frontend.
model AiCreditPurchase {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  packageId String @db.Uuid

  /// Copiados do pacote no momento da compra: mudar o preço do pacote amanhã
  /// não pode reescrever o que já foi vendido.
  creditos      Int
  precoCentavos Int

  status AiCreditPurchaseStatus @default(PENDENTE)

  /// Viaja no `external_reference` da preferência e volta no webhook — é por
  /// ele que o pagamento reencontra ESTA compra, em vez de ser adivinhado pelo
  /// valor, como acontece com os links estáticos de assinatura.
  externalReference       String  @unique
  mercadoPagoPreferenceId String? @unique
  /// Preenchido na confirmação. Unique: é a trava que impede uma reentrega do
  /// webhook de creditar o mesmo pacote duas vezes.
  mercadoPagoPaymentId    String? @unique
  checkoutUrl             String?

  creditadoEm DateTime? @db.Timestamptz()
  /// Por que foi cancelada, quando foi.
  motivo      String?

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pacote AiCreditPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([tenantId, criadoEm])
  @@index([status])
  @@map("ai_credit_purchases")
}
