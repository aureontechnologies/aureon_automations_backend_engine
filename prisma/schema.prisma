generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Tenancy
// ---------------------------------------------------------------------------

/// Plano contratado pelo tenant. Os LIMITES de cada plano não moram no banco:
/// vivem em `plan-catalog.ts`, fonte única consumida pela API, pelo web e
/// (via `GET /plans/current`) por qualquer cliente — mudar um limite é mudar
/// um arquivo, não migrar dados.
enum PlanoTipo {
  STARTER
  GROWTH
  SCALE

  @@map("plano_tipo")
}

model Tenant {
  id       String    @id @default(uuid()) @db.Uuid
  nome     String
  /// Tenants novos nascem no plano de entrada. A migration que criou este
  /// campo promoveu os tenants JÁ existentes a GROWTH, que era o plano que
  /// a interface exibia para todos até então.
  plano    PlanoTipo @default(STARTER)
  criadoEm DateTime  @default(now()) @db.Timestamptz()

  usuarios             Usuario[]
  whatsappConnections  WhatsAppConnection[]
  instagramConnections InstagramConnection[]
  facebookConnections  FacebookConnection[]
  contatos             Contato[]
  workflows            Workflow[]
  webhookEvents        ChannelWebhookEvent[]
  agentes              Agente[]
  customWebhooks       CustomWebhook[]
  mensagens            Mensagem[]
  assinatura           Assinatura?
  pagamentos           PagamentoMercadoPago[]
  aiCreditWallet       AiCreditWallet?
  aiCreditTransactions AiCreditTransaction[]
  aiCreditPurchases    AiCreditPurchase[]
  aiUsages             AiUsage[]
  equipes              Equipe[]
  etiquetas            Etiqueta[]
  conversas            Conversa[]
  conversaEventos      ConversaEvento[]
  mensagemTemplates    MensagemTemplate[]
  agendamentos         Agendamento[]
  kanbanQuadros        KanbanQuadro[]
  notificacoes         Notificacao[]

  @@map("tenants")
}

/// Papel do usuário DENTRO do tenant.
///
/// O cadastro público cria sempre o DONO; membros são criados por ele (ou por
/// um ADMIN) na tela de Equipe. DONO e ADMIN enxergam tudo; o MEMBRO só os
/// módulos listados em `Usuario.permissoes` — ver `permissoes.constants.ts`.
enum UsuarioPapel {
  DONO
  ADMIN
  MEMBRO

  @@map("usuario_papel")
}

model Usuario {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  senhaHash String
  tenantId  String   @db.Uuid
  criadoEm  DateTime @default(now()) @db.Timestamptz()

  /// `DONO` de propósito como padrão: todo usuário que já existia foi criado
  /// pelo cadastro público, e é o dono da própria conta.
  papel                 UsuarioPapel @default(DONO)
  /// Chaves dos módulos liberados ao MEMBRO. Ignorado para DONO e ADMIN.
  permissoes            Json         @default("[]")
  /// Membro desativado não entra nem recebe atendimentos — a linha fica para
  /// não apagar o histórico de quem atendeu o quê.
  ativo                 Boolean      @default(true)
  /// "Disponível para novos atendimentos" — entra no rodízio de atribuição.
  disponivelAtendimento Boolean      @default(true)
  cargo                 String?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  equipes             EquipeMembro[]
  conversasAtribuidas Conversa[]
  mensagensEnviadas   Mensagem[]
  conversaEventos     ConversaEvento[]
  agendamentos        Agendamento[]        @relation("AgendamentoResponsavel")
  agendamentosCriados Agendamento[]        @relation("AgendamentoCriador")
  kanbanCartoes       KanbanCartaoMembro[]
  notificacoes        Notificacao[]

  @@index([tenantId])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Equipes
// ---------------------------------------------------------------------------

/// Agrupamento de membros (Comercial, Suporte…). Um membro pode estar em mais
/// de uma equipe; a equipe serve para organizar e para transferir atendimentos.
model Equipe {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  nome         String
  descricao    String?
  cor          String?
  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membros EquipeMembro[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("equipes")
}

model EquipeMembro {
  equipeId  String   @db.Uuid
  usuarioId String   @db.Uuid
  criadoEm  DateTime @default(now()) @db.Timestamptz()

  equipe  Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([equipeId, usuarioId])
  @@index([usuarioId])
  @@map("equipe_membros")
}

// ---------------------------------------------------------------------------
// Notificações internas (sino da barra superior)
// ---------------------------------------------------------------------------

model Notificacao {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  usuarioId String    @db.Uuid
  /// `AUTOMACAO` | `ATENDIMENTO` | `AGENDA` | `KANBAN` — texto livre, só para ícone.
  tipo      String
  titulo    String
  mensagem  String?
  /// Rota da web para onde o clique leva (ex.: `/atendimento?conversa=<id>`).
  link      String?
  lidaEm    DateTime? @db.Timestamptz()
  criadoEm  DateTime  @default(now()) @db.Timestamptz()

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lidaEm, criadoEm])
  @@map("notificacoes")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @db.Uuid
  tokenHash  String
  expiraEm   DateTime  @db.Timestamptz()
  revogadoEm DateTime? @db.Timestamptz()
  criadoEm   DateTime  @default(now()) @db.Timestamptz()

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// WhatsApp / Meta connection
// ---------------------------------------------------------------------------

enum WhatsAppConnectionStatus {
  PENDENTE
  CONECTADO
  EXPIRADO
  ERRO

  @@map("whatsapp_connection_status")
}

model WhatsAppConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  wabaId             String
  phoneNumberId      String
  businessId         String?
  displayPhoneNumber String?
  verifiedName       String?

  /// Envelope AES-256-GCM serializado como "v1.<iv_b64>.<authTag_b64>.<ciphertext_b64>".
  /// Nunca decodificar/logar este campo fora do TokenCryptoService.
  accessTokenEncrypted String

  status       WhatsAppConnectionStatus @default(PENDENTE)
  conectadoEm  DateTime?                @db.Timestamptz()
  criadoEm     DateTime                 @default(now()) @db.Timestamptz()
  atualizadoEm DateTime                 @updatedAt @db.Timestamptz()

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversas         Conversa[]
  workflows         Workflow[]
  mensagemTemplates MensagemTemplate[]

  /// phoneNumberId da Meta é globalmente único — impede que um número
  /// migrado entre tenants sem limpeza cause roteamento cruzado de webhooks.
  @@unique([phoneNumberId])
  /// Um tenant pode conectar vários números de WhatsApp Business — cada
  /// automação escolhe a qual número seu gatilho responde.
  @@index([tenantId])
  @@map("whatsapp_connections")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  ERROR

  @@map("webhook_event_status")
}

model ChannelWebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String?            @db.Uuid
  provider        String             @default("meta")
  /// Hash SHA-256 do corpo bruto do webhook — usado para deduplicar reentregas do Meta.
  externalEventId String
  signatureValid  Boolean
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  erro            String?
  criadoEm        DateTime           @default(now()) @db.Timestamptz()
  processadoEm    DateTime?          @db.Timestamptz()

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([tenantId])
  @@index([status])
  /// Disparos recebidos por canal e período, na aba de Canais.
  @@index([tenantId, criadoEm])
  @@map("channel_webhook_events")
}

// ---------------------------------------------------------------------------
// Contatos / Conversas
// ---------------------------------------------------------------------------

enum ConversaStatus {
  ATIVA
  AGUARDANDO_RESPOSTA
  FINALIZADA

  @@map("conversa_status")
}

model Contato {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @db.Uuid
  telefone String
  nome     String?
  criadoEm DateTime @default(now()) @db.Timestamptz()

  /// Preenchido enquanto um Agente IA está conduzindo a conversa deste contato
  /// (nó "Agente IA" acionado num workflow) — enquanto setado, novas mensagens
  /// do contato vão direto para o agente e NÃO disparam avaliação de gatilhos
  /// de workflow. Limpo quando o próprio agente decide transferir para humano.
  agenteAtivoId    String?   @db.Uuid
  agenteAtivoDesde DateTime? @db.Timestamptz()

  /// Dados de CRM — editáveis na tela de Contatos, no painel do atendimento e
  /// pela ação "Definir campo" das automações (ver `CAMPOS_CONTATO`).
  email        String?
  observacoes  String?
  valor        Decimal  @default(0) @db.Decimal(12, 2)
  /// 0 a 5 estrelas.
  rating       Int      @default(0)
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz()

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agenteAtivo        Agente?             @relation(fields: [agenteAtivoId], references: [id], onDelete: SetNull)
  conversas          Conversa[]
  workflowExecutions WorkflowExecution[]
  mensagens          Mensagem[]
  etiquetas          ContatoEtiqueta[]
  eventos            ConversaEvento[]
  agendamentos       Agendamento[]
  kanbanCartoes      KanbanCartao[]

  @@unique([tenantId, telefone])
  @@index([tenantId])
  @@index([agenteAtivoId])
  @@index([tenantId, criadoEm])
  @@map("contatos")
}

/// Etiqueta livre do CRM. Diferente do sistema de referência (etiqueta única
/// por contato, presa a um grupo), aqui o contato pode ter quantas quiser —
/// como no BotConversa — e a etiqueta é criada pelo próprio usuário.
model Etiqueta {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  nome         String
  /// Hex (`#F5B800`). Só apresentação.
  cor          String   @default("#F5B800")
  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contatos ContatoEtiqueta[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("etiquetas")
}

model ContatoEtiqueta {
  contatoId  String   @db.Uuid
  etiquetaId String   @db.Uuid
  criadoEm   DateTime @default(now()) @db.Timestamptz()

  contato  Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contatoId, etiquetaId])
  @@index([etiquetaId])
  @@map("contato_etiquetas")
}

enum MensagemDirecao {
  ENTRADA
  SAIDA

  @@map("mensagem_direcao")
}

/// O que o contato mandou (ou o que o sistema enviou). Um valor por FORMA de
/// mensagem — é o que permite ao Agente IA e às automações saberem se veio
/// texto, uma foto, uma localização ou um clique em botão.
///
/// `MIDIA` continua existindo por compatibilidade: é o que os nós de envio
/// usam para qualquer anexo que o sistema manda.
enum MensagemTipo {
  TEXTO
  BOTOES
  MIDIA
  IMAGEM
  VIDEO
  AUDIO
  DOCUMENTO
  STICKER
  LOCALIZACAO
  CONTATO
  REACAO
  COMPARTILHAMENTO
  STORY
  NAO_SUPORTADO
  /// Modelo de mensagem aprovado pela Meta — o único envio permitido com a
  /// janela de 24h fechada.
  TEMPLATE

  @@map("mensagem_tipo")
}

/// Situação de entrega de uma mensagem ENVIADA, vinda dos `statuses` do
/// webhook da Meta. Nula nas mensagens recebidas.
enum MensagemStatusEnvio {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU

  @@map("mensagem_status_envio")
}

/// Histórico normalizado de mensagens trocadas com um contato, através de
/// qualquer canal — usado como contexto de conversa para os Agentes IA e como
/// trilha de auditoria das execuções de workflow. Independente de `Conversa`
/// (que hoje só existe para WhatsApp e não guarda o conteúdo das mensagens).
model Mensagem {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  contatoId String          @db.Uuid
  canal     Canal
  direcao   MensagemDirecao
  tipo      MensagemTipo    @default(TEXTO)
  /// Texto legível da mensagem — o que o contato escreveu ou, quando não há
  /// texto, uma descrição do que chegou ("[imagem]", "[localização] …"). É o
  /// que o Agente IA lê como histórico da conversa.
  conteudo  String?
  /// O que veio além do texto, já normalizado: anexos (url ou id da mídia),
  /// localização, cartão de contato, reação e a que story/post a mensagem
  /// responde. Forma em `inbound-message.dto.ts`.
  metadata  Json?
  criadoEm  DateTime        @default(now()) @db.Timestamptz()

  /// Conversa do atendimento a que a mensagem pertence. Nula nas mensagens
  /// gravadas antes do atendimento existir — a tela as encontra pelo contato.
  conversaId  String?              @db.Uuid
  /// Id da mensagem na Meta (`wamid.…`) — é por ele que os `statuses` do
  /// webhook (entregue, lida) encontram a mensagem.
  wamid       String?              @unique
  statusEnvio MensagemStatusEnvio?
  erroEnvio   String?
  /// Membro que enviou pelo atendimento. Nulo quando quem enviou foi a
  /// automação, o Agente IA, ou quando a mensagem é do contato.
  usuarioId   String?              @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contato  Contato   @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  conversa Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contatoId, criadoEm])
  /// Volume de mensagens por período no painel — o índice por contato não
  /// serve para a contagem do tenant inteiro.
  @@index([tenantId, criadoEm])
  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

/// Conversa do ATENDIMENTO (bate-papo ao vivo): um contato falando com UM
/// número conectado. É a linha que a lista do atendimento ordena, filtra e
/// atribui — as mensagens continuam em `Mensagem`.
///
/// Status: `ATIVA` = aberta, `FINALIZADA` = fechada. `AGUARDANDO_RESPOSTA`
/// existe desde o início do schema e não é usado pelo atendimento.
model Conversa {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  contatoId            String         @db.Uuid
  whatsappConnectionId String         @db.Uuid
  status               ConversaStatus @default(ATIVA)

  /// Membro responsável. Nulo = "não atribuída".
  atribuidoAId          String?          @db.Uuid
  naoLidas              Int              @default(0)
  ultimaMensagemEm      DateTime?        @db.Timestamptz()
  ultimaMensagemPreview String?
  ultimaMensagemDirecao MensagemDirecao?
  /// Última mensagem DO CONTATO. A janela de atendimento de 24h da Meta conta
  /// a partir daqui: fora dela, só modelo de mensagem aprovado pode ser enviado.
  ultimaEntradaEm       DateTime?        @db.Timestamptz()
  finalizadaEm          DateTime?        @db.Timestamptz()

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contato            Contato            @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  whatsappConnection WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  atribuidoA         Usuario?           @relation(fields: [atribuidoAId], references: [id], onDelete: SetNull)
  mensagens          Mensagem[]
  eventos            ConversaEvento[]

  @@unique([contatoId, whatsappConnectionId])
  @@index([contatoId])
  @@index([whatsappConnectionId])
  /// A lista do atendimento: "abertas deste tenant, mais recentes primeiro".
  @@index([tenantId, status, ultimaMensagemEm])
  @@index([tenantId, atribuidoAId])
  @@map("conversas")
}

/// O que aconteceu na conversa além das mensagens — etiqueta adicionada,
/// transferência, finalização, agendamento criado… É a linha tracejada no
/// meio do chat, igual ao sistema de referência.
///
/// Tabela própria, e não uma `Mensagem` de tipo especial: o histórico de
/// mensagens é lido pelo Agente IA e contado pelo Analytics, e evento de
/// sistema não pode virar fala do contato para nenhum dos dois.
enum ConversaEventoTipo {
  ETIQUETA_ADICIONADA
  ETIQUETA_REMOVIDA
  ATRIBUIDA
  TRANSFERIDA
  ATRIBUICAO_REMOVIDA
  FINALIZADA
  REABERTA
  AGENDAMENTO_CRIADO
  KANBAN_CARTAO
  AUTOMACAO_INICIADA
  CAMPO_ALTERADO
  MEMBRO_NOTIFICADO

  @@map("conversa_evento_tipo")
}

model ConversaEvento {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  /// O evento é do CONTATO: aparece em qualquer conversa dele.
  contatoId  String             @db.Uuid
  conversaId String?            @db.Uuid
  tipo       ConversaEventoTipo
  /// Texto já pronto para exibir ("Etiqueta *Lead quente* adicionada por Ana").
  descricao  String
  /// `MANUAL` | `AUTOMACAO` | `SISTEMA`.
  origem     String             @default("MANUAL")
  /// Quem fez. Nulo quando foi a automação ou o próprio sistema.
  usuarioId  String?            @db.Uuid
  metadata   Json?
  criadoEm   DateTime           @default(now()) @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contato  Contato   @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  conversa Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([contatoId, criadoEm])
  @@index([tenantId, criadoEm])
  @@map("conversa_eventos")
}

// ---------------------------------------------------------------------------
// Modelos de mensagem (templates da Meta)
// ---------------------------------------------------------------------------

/// Categoria do modelo, na linguagem do produto. `MARKETING_LITE` é um
/// modelo de categoria MARKETING na Meta, enviado pela API de Marketing
/// Messages Lite — a diferença é o canal de envio, não o modelo.
enum TemplateCategoria {
  MARKETING_LITE
  MARKETING
  UTILIDADE

  @@map("template_categoria")
}

enum TemplateStatus {
  /// Ainda não foi enviado para a Meta.
  RASCUNHO
  PENDENTE
  APROVADO
  REJEITADO
  PAUSADO
  DESATIVADO

  @@map("template_status")
}

model MensagemTemplate {
  id                   String @id @default(uuid()) @db.Uuid
  tenantId             String @db.Uuid
  whatsappConnectionId String @db.Uuid

  /// Id do modelo na Meta — nulo enquanto é rascunho.
  metaTemplateId String?           @unique
  /// Nome na Meta: minúsculas, números e `_`.
  nome           String
  /// Código de idioma da Meta (`pt_BR`, `en_US`…).
  idioma         String            @default("pt_BR")
  categoria      TemplateCategoria
  status         TemplateStatus    @default(RASCUNHO)

  /// `{ tipo: 'TEXTO'|'IMAGEM'|'VIDEO'|'DOCUMENTO', texto?, exemploUrl?, exemploHandle? }`
  cabecalho        Json?
  /// Corpo com variáveis `{{1}}`, `{{2}}`…
  corpo            String
  /// Exemplos das variáveis do corpo, na ordem — a Meta exige para aprovar.
  corpoExemplos    Json    @default("[]")
  rodape           String?
  /// `[{ tipo: 'RESPOSTA_RAPIDA'|'URL'|'TELEFONE', texto, url?, telefone? }]`
  botoes           Json    @default("[]")
  /// Período de validade da mensagem (`message_send_ttl_seconds`): passado
  /// esse tempo sem conseguir entregar, a Meta desiste.
  validadeSegundos Int?
  motivoRejeicao   String?
  /// `GREEN` | `YELLOW` | `RED` | `UNKNOWN`, como a Meta informa.
  qualidade        String?

  criadoEm       DateTime  @default(now()) @db.Timestamptz()
  atualizadoEm   DateTime  @updatedAt @db.Timestamptz()
  sincronizadoEm DateTime? @db.Timestamptz()

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappConnection WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)

  @@unique([whatsappConnectionId, nome, idioma])
  @@index([tenantId])
  @@map("mensagem_templates")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

enum AgendamentoStatus {
  CONFIRMADO
  PENDENTE
  CONCLUIDO
  CANCELADO

  @@map("agendamento_status")
}

model Agendamento {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  /// Membro responsável. Nulo só se o membro foi removido depois.
  usuarioId String? @db.Uuid
  contatoId String? @db.Uuid

  titulo     String
  descricao  String?
  local      String?
  link       String?
  inicio     DateTime          @db.Timestamptz()
  fim        DateTime          @db.Timestamptz()
  diaInteiro Boolean           @default(false)
  status     AgendamentoStatus @default(CONFIRMADO)
  cor        String?

  /// Avisar o responsável N minutos antes (notificação no sino).
  lembreteMinutos   Int?
  lembreteEnviadoEm DateTime? @db.Timestamptz()

  /// `MANUAL` | `AUTOMACAO`.
  origem      String  @default("MANUAL")
  criadoPorId String? @db.Uuid

  criadoEm     DateTime @default(now()) @db.Timestamptz()
  atualizadoEm DateTime @updatedAt @db.Timestamptz()

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation("AgendamentoResponsavel", fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoPor Usuario? @relation("AgendamentoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  contato   Contato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)

  @@index([tenantId, inicio])
  @@index([usuarioId, inicio])
  @@index([contatoId])
  /// O poller de lembretes varre "ainda não avisados, começando em breve".
  @@index([lembreteEnviadoEm, inicio])
  @@map("agendamentos")
}

